# Example environment variables
# Copy the required variables into a local .env file.
# Replace placeholders with actual values locally.
# Never commit real secrets.

# Backend server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=replace_with_your_mongodb_connection_string

# Staff authentication secret, if using signed tokens
STAFF_AUTH_SECRET=replace_with_a_long_random_secret

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5500

# Frontend API base URL configuration
# For plain HTML/CSS/JS, configure this in frontend JavaScript
# or a non-secret public config file; browser code will not
# automatically read server-side .env variables.
API_BASE_URL=http://localhost:5000/api
